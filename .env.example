# THERMO environment configuration.
# All values are OPTIONAL. The application runs fully in Demo Mode
# without any external API keys.

# --- Mapping -------------------------------------------------------
# THERMO uses free OpenStreetMap raster tiles by default.
# If you have a MapTiler/Mapbox key you can switch tile providers.
# VITE_TILE_STYLE_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png

# --- Data mode (default: demo) --------------------------------------
# VITE_DATA_MODE=demo